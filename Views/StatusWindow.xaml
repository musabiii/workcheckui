<Window x:Class="WorkCheck.Views.StatusWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkCheck"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Width="324" MinHeight="146" SizeToContent="Height">

    <Border Background="{Binding WindowBgBrush}" CornerRadius="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="2"/>
        </Border.Effect>

        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Click="OnProjectsClick" Style="{StaticResource HeaderButton}"
                        Foreground="{DynamicResource YellowBrush}" FontSize="12" FontWeight="SemiBold"
                        Padding="6,2" Margin="-6,0,0,0"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        ToolTip="Выбрать проект">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="▾" Margin="4,0,0,0" Opacity="0.7"/>
                        <TextBlock Text="{Binding ProjectName}" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource PopupMenu}"/>
                    </Button.ContextMenu>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,0,0,0">
                    <Button Content="☰" Click="OnMenuClick"
                            Style="{StaticResource HeaderButton}" Margin="0,0,2,0"
                            ToolTip="Меню">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource PopupMenu}">
                                <MenuItem Header="↺  Обнулить" Command="{Binding ResetCommand}"/>
                                <MenuItem Header="ℹ  О приложении" Command="{Binding OpenAboutCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="📊" Command="{Binding OpenStatisticsCommand}"
                            Style="{StaticResource HeaderButton}" Margin="0,0,2,0"
                            ToolTip="Статистика"/>
                    <Button Content="&#xE713;" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource HeaderButton}" Margin="0,0,2,0"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                            ToolTip="Настройки"/>
                    <Button Content="☕" Command="{Binding ManualBreakCommand}"
                            Style="{StaticResource HeaderButton}" Margin="0,0,2,0"
                            Foreground="{DynamicResource YellowBrush}"
                            ToolTip="Ручной перерыв"/>
                    <Button Content="🖃" Click="OnMinimizeClick"
                            Style="{StaticResource HeaderButton}" Margin="0,0,2,0"
                            ToolTip="Свернуть"/>
                    <Button Content="✕" Command="{Binding CloseAppCommand}"
                            Style="{StaticResource CloseButton}"/>
                </StackPanel>
            </Grid>

            <!-- Stats -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Текущая сессия -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="{Binding SessionBrush}" FontSize="13"
                               FontWeight="Bold">
                        <Run Text="{Binding SessionIcon, Mode=OneWay}"/><Run Text="{Binding SessionLabel, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentSessionText}" Foreground="{Binding SessionBrush}"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Separator Grid.Row="1" Margin="0,0,0,2" Background="#33FFFFFF" Height="1"/>

                <!-- Сегодня (режим «Дрейфую») -->
                <Grid Margin="0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWorkMode}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📊  Сегодня:" Foreground="{DynamicResource Subtext1Brush}" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding TodayWorkedText}" Foreground="{DynamicResource TextBrush}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Проекты за сегодня (режим «В работе») -->
                <ItemsControl ItemsSource="{Binding ProjectRows}"
                              Visibility="{Binding IsWorkMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NameText" Grid.Column="0" Foreground="{DynamicResource Subtext1Brush}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                    <Run Text="📁  "/><Run Text="{Binding Name, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{DynamicResource TextBrush}"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource YellowBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,2,0,2" Background="#33FFFFFF" Height="1"
                           Visibility="{Binding IsWorkMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Вне компьютера -->
                <Grid Margin="0,0" Visibility="{Binding IsWorkMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding AwayLabel}" Foreground="{DynamicResource Subtext1Brush}" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding AwayTimeText}" Foreground="{DynamicResource TextBrush}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>

            </StackPanel>

            <!-- Footer: mode toggle + status -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Button Content="{Binding ModeButtonText}"
                        Command="{Binding ToggleModeCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource HeaderButton}"
                        FontSize="12"/>

                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                           FontSize="12" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>