<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pomodoro: the app's own theme. Cream paper, a tomato-red accent, a green leaf for work -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#FFF8F1"/>

    <!-- Card background in dialogs with a system backdrop; this theme has none, so it is the window background -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#FFF8F1"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#EEFFF8F1"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#FCEDE2"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#F2FCEDE2"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#F6E1D2"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#E8E4E0"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#F5E1D3"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#E2BFA8"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#EED6C6"/>

    <!-- Outline of text fields and check boxes -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#E2BFA8"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#A88B82"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#8F6F66"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#75524A"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#5C3A30"/>
    <SolidColorBrush x:Key="TextBrush" Color="#3B1F17"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#4C9A2A"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#43882A"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#D98A00"/>
    <SolidColorBrush x:Key="RedBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#B02222"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#961D1D"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#33C62828"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#3B7DD8"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#326BBA"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#2A5A9E"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#9C5BB5"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#F08A4B"/>
    <SolidColorBrush x:Key="TealBrush" Color="#2A9D8F"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#E5483B"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D33C30"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B83228"/>

    <!-- Accent used as a text color, e.g. the selected segment -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#D33C30"/>

    <!-- Outline of every window -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#40E5483B"/>

    <!-- Title text of a window title bar -->
    <SolidColorBrush x:Key="WindowHeaderTextBrush" Color="#3B1F17"/>

    <!-- Overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#0B000000"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#0A000000"/>

    <!-- Shape: soft round corners like a tomato, a warm shadow -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">18</CornerRadius>
    <CornerRadius x:Key="Radius2xl">22</CornerRadius>
    <CornerRadius x:Key="RadiusXlStart">18,0,0,18</CornerRadius>
    <CornerRadius x:Key="Radius2xlTop">22,22,0,0</CornerRadius>
    <DropShadowEffect x:Key="ShadowSm" Color="#7A3B2E" BlurRadius="20" Opacity="0.18" ShadowDepth="4"/>
    <DropShadowEffect x:Key="ShadowMd" Color="#7A3B2E" BlurRadius="24" Opacity="0.22" ShadowDepth="5"/>
    <DropShadowEffect x:Key="ShadowLg" Color="#7A3B2E" BlurRadius="32" Opacity="0.26" ShadowDepth="6"/>
</ResourceDictionary>
