<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme-independent tokens; colors live in the per-theme files -->

    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeLarge">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeHeadline">24</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">42</sys:Double>
    <sys:Double x:Key="FontSizeHero">56</sys:Double>

    <CornerRadius x:Key="RadiusXs">2</CornerRadius>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="Radius2xl">16</CornerRadius>

    <DropShadowEffect x:Key="ShadowSm" Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="2"/>
    <DropShadowEffect x:Key="ShadowMd" Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="3"/>
    <DropShadowEffect x:Key="ShadowLg" Color="Black" BlurRadius="30" Opacity="0.6" ShadowDepth="4"/>

</ResourceDictionary>
