<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 Fluent, dark: Mica behind dialogs (see WindowBackdrop), translucent white control fills,
         the default system accent, 4px controls and 8px windows -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#202020"/>

    <!-- Tint over Mica in dialogs that have it; themes without a backdrop set it to their BaseBrush -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#1A202020"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#DD202020"/>

    <!-- Inset panels: Fluent cards -->
    <SolidColorBrush x:Key="MantleBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#E62B2B2B"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#0AFFFFFF"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#2A2A2A"/>

    <!-- Inputs, toggles, buttons: Fluent control fills -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#18FFFFFF"/>
    <!-- Outline of text fields and check boxes -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#24FFFFFF"/>

    <!-- Muted text and icons: Fluent text opacities -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#8BFFFFFF"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#C8FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#000000"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#7FD474"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#FF8585"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#E65A5A"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#44FF6B6B"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#57B9E8"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#4DA6D1"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#B4A0FF"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#FF9E5E"/>
    <SolidColorBrush x:Key="TealBrush" Color="#4CC9B0"/>

    <!-- Signature color of the theme: the default Windows accent in dark mode -->
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#57B9E8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4DA6D1"/>
    <!-- Accent used as a text color, e.g. the selected segment -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#60CDFF"/>

    <!-- Outline of every window: Fluent's subtle stroke -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#26FFFFFF"/>

    <!-- Title text of a window title bar -->
    <SolidColorBrush x:Key="WindowHeaderTextBrush" Color="#FFFFFF"/>

    <!-- Light overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#08FFFFFF"/>

    <!-- Shape: Fluent corners, a soft shadow -->
    <CornerRadius x:Key="RadiusXs">2</CornerRadius>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">4</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">8</CornerRadius>
    <CornerRadius x:Key="Radius2xl">8</CornerRadius>
    <CornerRadius x:Key="RadiusXlStart">8,0,0,8</CornerRadius>
    <CornerRadius x:Key="Radius2xlTop">8,8,0,0</CornerRadius>
    <DropShadowEffect x:Key="ShadowSm" Color="Black" BlurRadius="24" Opacity="0.35" ShadowDepth="6"/>
    <DropShadowEffect x:Key="ShadowMd" Color="Black" BlurRadius="28" Opacity="0.4" ShadowDepth="8"/>
    <DropShadowEffect x:Key="ShadowLg" Color="Black" BlurRadius="36" Opacity="0.45" ShadowDepth="10"/>
</ResourceDictionary>
