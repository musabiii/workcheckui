<views:ThemedWindow x:Class="WorkCheck.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkCheck.Views"
        Title="Статистика"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Width="680" Height="560"
        MinWidth="600" MinHeight="460"
        Shadow="{DynamicResource ShadowSm}"
        Padding="20">

    <Window.Resources>
        <Style x:Key="StatsGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CrustBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Subtext0Brush}"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrimmedCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="SmallSegment" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadio}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        </Style>

        <!-- Small buttons of the manual plan -->
        <Style x:Key="PlanChip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Subtext1Brush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="10,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Surface1Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="◀" Click="OnPreviousClick" Cursor="Hand"
                        Padding="10,4" FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold"
                        Style="{StaticResource CloseButton}"/>
                <TextBlock x:Name="DateText" Text="05.03.2026" Foreground="{DynamicResource AccentBrush}"
                           FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="12,0"/>
                <Button Content="▶" Click="OnNextClick" Cursor="Hand"
                        Padding="10,4" FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold"
                        Style="{StaticResource CloseButton}"/>
                <Button x:Name="TodayButton" Content="Сегодня" Click="OnTodayClick"
                        Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="{StaticResource FontSizeSmall}"
                        VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="3"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="DayPeriodRadio" Content="День" GroupName="Period"
                                 Style="{StaticResource SegmentRadio}" IsChecked="True"
                                 Checked="OnFilterChanged"/>
                    <RadioButton x:Name="WeekPeriodRadio" Content="Неделя" GroupName="Period"
                                 Style="{StaticResource SegmentRadio}"
                                 Checked="OnFilterChanged"/>
                    <RadioButton x:Name="MonthPeriodRadio" Content="Месяц" GroupName="Period"
                                 Style="{StaticResource SegmentRadio}"
                                 Checked="OnFilterChanged"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="2" Content="✕" Click="OnCloseClick" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource CloseButton}"/>
        </Grid>

        <!-- Summary -->
        <Border Grid.Row="1" Background="{DynamicResource MantleBrush}" CornerRadius="{DynamicResource RadiusLg}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Всего сессий" Foreground="{DynamicResource Overlay0Brush}" FontSize="{StaticResource FontSizeSmall}"/>
                        <TextBlock x:Name="SessionCountText" Text="0" Foreground="{DynamicResource TextBrush}"
                                   FontSize="{StaticResource FontSizeHeadline}" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Общее время" Foreground="{DynamicResource Overlay0Brush}" FontSize="{StaticResource FontSizeSmall}"/>
                        <TextBlock x:Name="TotalTimeText" Text="0 мин" Foreground="{DynamicResource GreenBrush}"
                                   FontSize="{StaticResource FontSizeHeadline}" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="Сессии:" Foreground="{DynamicResource Overlay0Brush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AllSessionsRadio" Content="Все" GroupName="SessionFilter"
                                             Style="{StaticResource SmallSegment}" IsChecked="True"
                                             Checked="OnFilterChanged"/>
                                <RadioButton Content="Полные сессии" GroupName="SessionFilter"
                                             Style="{StaticResource SmallSegment}"
                                             Checked="OnFilterChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="2" Margin="0,0,8,0"
                                ToolTip="Как показывать перерывы и время не у компа">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="По типу" GroupName="Grouping"
                                             Style="{StaticResource SmallSegment}"
                                             Checked="OnFilterChanged"/>
                                <RadioButton x:Name="ProjectGroupingRadio" Content="По проектам" GroupName="Grouping"
                                             Style="{StaticResource SmallSegment}" IsChecked="True"
                                             Checked="OnFilterChanged"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ListViewRadio" Content="Список" GroupName="SessionView"
                                             Style="{StaticResource SmallSegment}"
                                             Checked="OnViewChanged"/>
                                <RadioButton Content="Диаграмма" GroupName="SessionView"
                                             Style="{StaticResource SmallSegment}"
                                             IsChecked="True" Checked="OnViewChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="GanttView" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <views:GanttChart x:Name="Gantt" VerticalAlignment="Top"
                                     MinHeight="{Binding ViewportHeight, ElementName=GanttView}"/>
                </ScrollViewer>

                <!-- Plan: more work from now on, or a total for today minus what is done; laid out in
                     pomodoros over the next 6 hours -->
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Height="1" Background="{DynamicResource Surface1Brush}" VerticalAlignment="Top"/>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,16,0,8">
                        <TextBlock Text="План: поработать" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="2" Margin="8,0,0,0"
                                ToolTip="«ещё» — с этого момента; «всего» — за сегодня, с учётом уже отработанного">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PlanMoreRadio" Content="ещё" GroupName="PlanMode" Style="{StaticResource SmallSegment}"
                                             IsChecked="True" Checked="OnPlanChanged"/>
                                <RadioButton x:Name="PlanTotalRadio" Content="всего" GroupName="PlanMode"
                                             Style="{StaticResource SmallSegment}" Checked="OnPlanChanged"/>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="PlanInput" Width="48" Height="24" Margin="8,0,4,0" Padding="4,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="{StaticResource FontSizeSmall}"
                                 Foreground="{DynamicResource TextBrush}" Background="{DynamicResource Surface0Brush}"
                                 BorderBrush="{DynamicResource Surface1Brush}" CaretBrush="{DynamicResource TextBrush}"
                                 TextChanged="OnPlanChanged"
                                 ToolTip="Часы: 3, 2,5 или 2:30. Минуты: 90м"/>
                        <TextBlock Text="ч" Foreground="{DynamicResource Overlay1Brush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                        <TextBlock Text="·  помидор" Margin="12,0,0,0" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="PomodoroInput" Width="40" Height="24" Margin="8,0,4,0" Padding="4,0" VerticalContentAlignment="Center" FontSize="{StaticResource FontSizeSmall}"
                                 Foreground="{DynamicResource TextBrush}" Background="{DynamicResource Surface0Brush}"
                                 BorderBrush="{DynamicResource Surface1Brush}" CaretBrush="{DynamicResource TextBrush}"
                                 HorizontalContentAlignment="Center" TextChanged="OnPlanChanged" ToolTip="Длина помидора в минутах"/>
                        <TextBlock Text="перерыв" Margin="12,0,0,0" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="PauseInput" Width="40" Height="24" Margin="8,0,4,0" Padding="4,0" VerticalContentAlignment="Center" FontSize="{StaticResource FontSizeSmall}"
                                 Foreground="{DynamicResource TextBrush}" Background="{DynamicResource Surface0Brush}"
                                 BorderBrush="{DynamicResource Surface1Brush}" CaretBrush="{DynamicResource TextBrush}"
                                 HorizontalContentAlignment="Center" TextChanged="OnPlanChanged" ToolTip="Длина перерыва в минутах"/>
                        <TextBlock Text="мин" Foreground="{DynamicResource Overlay1Brush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Fill: automatic pomodoros, or blocks added by hand; works with both ещё and всего -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Заполнение:" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="2" Margin="8,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PlanAutoRadio" Content="авто" GroupName="PlanFill"
                                             Style="{StaticResource SmallSegment}" IsChecked="True" Checked="OnPlanChanged"/>
                                <RadioButton x:Name="PlanManualRadio" Content="вручную" GroupName="PlanFill"
                                             Style="{StaticResource SmallSegment}" Checked="OnPlanChanged"/>
                            </StackPanel>
                        </Border>
                    <!-- Manual plan: each click appends one block of work and break -->
                    <StackPanel x:Name="ManualPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="+ Добавить" Style="{StaticResource PlanChip}" Click="OnAddBlockClick"
                                ToolTip="Добавить блок из полей «помидор» и «перерыв»"/>
                        <Button Content="25/5" Tag="25/5" Style="{StaticResource PlanChip}" Click="OnAddPresetClick"/>
                        <Button Content="50/10" Tag="50/10" Style="{StaticResource PlanChip}" Click="OnAddPresetClick"/>
                        <Button Content="Обед 60" Tag="0/60" Style="{StaticResource PlanChip}" Click="OnAddPresetClick"
                                ToolTip="Час перерыва без работы"/>
                        <Button Content="↶ Убрать" Style="{StaticResource PlanChip}" Click="OnRemoveBlockClick" Margin="12,0,6,0"/>
                        <Button Content="Очистить" Style="{StaticResource PlanChip}" Click="OnClearBlocksClick"/>
                    </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="PlanResult" Grid.Row="2" Margin="0,0,0,8" FontSize="{StaticResource FontSizeSmall}" TextTrimming="CharacterEllipsis"/>
                    <views:GanttChart x:Name="PlanChart" Grid.Row="3" ShowZoomHint="False"/>
                </Grid>

                <!-- Productivity: work on projects as a share of all time at the computer -->
                <TextBlock x:Name="ProductivityText" Grid.Row="3" Margin="0,12,0,0" FontSize="{StaticResource FontSizeSmall}"
                           ToolTip="Время работы по проектам / время за компьютером (работа + дрейф)">
                    <Run Text="Продуктивность: " Foreground="{DynamicResource Subtext1Brush}"/><Run x:Name="ProductivityValue"
                         FontWeight="SemiBold"/><Run x:Name="ProductivityDetail" Foreground="{DynamicResource Overlay1Brush}"/>
                </TextBlock>

                <ScrollViewer x:Name="ListView" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <Grid>
                        <DataGrid x:Name="SessionsGrid" Style="{StaticResource StatsGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat={}{0:HH:mm}}" Width="70"/>
                                <DataGridTextColumn Header="Конец" Binding="{Binding EndTime, StringFormat={}{0:HH:mm}}" Width="70"/>
                                <DataGridTextColumn Header="Длительность" Binding="{Binding DurationText}" Width="110"/>
                                <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="130"
                                                    ElementStyle="{StaticResource TrimmedCell}"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid x:Name="PeriodGrid" Style="{StaticResource StatsGrid}" Visibility="Collapsed">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</views:ThemedWindow>
