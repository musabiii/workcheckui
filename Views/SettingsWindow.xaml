<Window x:Class="WorkCheck.Views.SettingsWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkCheck.Views"
        xmlns:helpers="clr-namespace:WorkCheck.Helpers"
        Title="Настройки — WorkCheck"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="432" Height="552"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:EqualsConverter x:Key="EqualsConverter"/>

        <Style x:Key="ThemeOption" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadio}">
            <Setter Property="GroupName" Value="Theme"/>
            <Setter Property="Padding" Value="0,6"/>
        </Style>

        <!-- Caption over a group of segments, e.g. dark and light themes -->
        <Style x:Key="GroupCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay1Brush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- A number setting on one line: label on the left, a short field on the right -->
        <Style x:Key="NumberInput" TargetType="TextBox" BasedOn="{StaticResource TextInput}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NumberLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BaseBrush}" CornerRadius="{DynamicResource RadiusXl}" Margin="{StaticResource WindowShadowSpace}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Border.Effect><DynamicResource ResourceKey="ShadowMd"/></Border.Effect>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Настройки" Foreground="{DynamicResource TextBrush}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold"/>
                <Button Content="✕" HorizontalAlignment="Right"
                        Style="{StaticResource CloseButton}"
                        Click="OnCancelClick"/>
            </Grid>

            <!-- Tabs -->
            <Border Grid.Row="1" Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="3"
                    Margin="0,0,0,16">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="AppearanceTab" Content="Оформление" GroupName="Tab"
                                 Style="{StaticResource SegmentRadio}" Padding="0,6"/>
                    <RadioButton x:Name="TimersTab" Content="Таймеры" GroupName="Tab"
                                 Style="{StaticResource SegmentRadio}" Padding="0,6"/>
                    <RadioButton x:Name="NotificationsTab" Content="Уведомления" GroupName="Tab"
                                 Style="{StaticResource SegmentRadio}" Padding="0,6"/>
                    <RadioButton x:Name="ProjectsTab" Content="Проекты" GroupName="Tab"
                                 Style="{StaticResource SegmentRadio}" Padding="0,6"/>
                </UniformGrid>
            </Border>

            <!-- Tab pages -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0"
                              Visibility="{Binding IsChecked, ElementName=AppearanceTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Шрифт" Style="{StaticResource FieldLabel}"/>
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="3">
                            <UniformGrid Columns="3">
                                <RadioButton Content="Из темы" GroupName="Font"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             IsChecked="{Binding IsThemeFont}"/>
                                <!-- Each option is shown in its own font -->
                                <RadioButton Content="Системный" GroupName="Font"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             FontFamily="Segoe UI"
                                             IsChecked="{Binding IsSystemFont}"/>
                                <RadioButton Content="JetBrains Mono" GroupName="Font"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             FontFamily="pack://application:,,,/files/fonts/#JetBrains Mono"
                                             IsChecked="{Binding IsJetBrainsMonoFont}"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="Тема" Style="{StaticResource FieldLabel}" Margin="0,16,0,8"/>
                        <TextBlock Text="Тёмные" Style="{StaticResource GroupCaption}"/>
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="3">
                            <UniformGrid Columns="4">
                                <RadioButton Content="Catppuccin" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Mocha}}"/>
                                <RadioButton Content="GitHub" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.GitHubDark}}"/>
                                <RadioButton Content="Darcula" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Darcula}}"/>
                                <RadioButton Content="Gruvbox" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Gruvbox}}"/>
                                <RadioButton Content="Tokyo Night" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.TokyoNight}}"/>
                                <RadioButton Content="Dracula" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Dracula}}"/>
                                <RadioButton Content="Nord" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Nord}}"/>
                                <RadioButton Content="Synthwave" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Synthwave}}"/>
                                <RadioButton Content="Cyberpunk" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Cyberpunk}}"/>
                                <RadioButton Content="Terminal" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Terminal}}"/>
                                <RadioButton Content="Fluent" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.FluentDark}}"/>
                                <RadioButton Content="Glass" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.GlassDark}}"/>
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="Светлые" Style="{StaticResource GroupCaption}" Margin="0,12,0,4"/>
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="3">
                            <UniformGrid Columns="4">
                                <RadioButton Content="Latte" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Latte}}"/>
                                <RadioButton Content="GitHub Light" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.GitHubLight}}"/>
                                <RadioButton Content="Solarized" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.SolarizedLight}}"/>
                                <RadioButton Content="Glass" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.Glass}}"/>
                                <RadioButton Content="Fluent" Style="{StaticResource ThemeOption}"
                                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static helpers:AppThemes.FluentLight}}"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0"
                              Visibility="{Binding IsChecked, ElementName=TimersTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Работа" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pomodoro, мин" Style="{StaticResource NumberLabel}"/>
                                    <TextBox Text="{Binding PomodoroMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumberInput}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pomodoro 2, мин" Style="{StaticResource NumberLabel}"/>
                                    <TextBox Text="{Binding Pomodoro2Minutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumberInput}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Перерывы" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Короткий перерыв, мин" Style="{StaticResource NumberLabel}"/>
                                    <TextBox Text="{Binding ShortBreakMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumberInput}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Неактивность, мин" Style="{StaticResource NumberLabel}"/>
                                    <TextBox Text="{Binding InactivityMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumberInput}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0"
                              Visibility="{Binding IsChecked, ElementName=NotificationsTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Telegram" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Отправлять в Telegram" IsChecked="{Binding TelegramEnabled}" Margin="0,0,0,12"/>

                                <TextBlock Text="Bot Token" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="TokenBox" Style="{StaticResource PasswordInput}"/>

                                <TextBlock Text="Chat ID" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}"/>

                                <TextBlock Text="SOCKS5 прокси (user:pass@host:port)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}" ToolTip="Пример: user:password@203.0.113.10:1080"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TestStatus}" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeCaption}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="Тест"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OnTestTelegramClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="ntfy" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Отправлять в ntfy" IsChecked="{Binding NtfyEnabled}" Margin="0,0,0,12"/>

                                <TextBlock Text="Сервер" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NtfyServer, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}" ToolTip="Пусто — https://ntfy.sh. Свой сервер: https://ntfy.example.com"/>

                                <TextBlock Text="Подписка (топик)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding NtfyTopic, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextInput}"
                                         ToolTip="Имя топика, на который подписано приложение ntfy на телефоне. На ntfy.sh лучше выбрать трудноугадываемое"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding NtfyTestStatus}" Margin="0,0,8,0"
                                               Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeCaption}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="Тест"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding TestNtfyCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Звук" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Звуковое уведомление о конце перерыва" IsChecked="{Binding SoundEnabled}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <views:ProjectsPanel x:Name="Projects"
                                     Visibility="{Binding IsChecked, ElementName=ProjectsTab, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick" Margin="0,0,8,0"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
