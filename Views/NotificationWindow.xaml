<Window x:Class="WorkCheck.Views.NotificationWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        SizeToContent="Height"
        Width="400">

    <!-- Padding reserves space for the DropShadowEffect so it isn't clipped -->
    <Grid x:Name="OuterRoot" Margin="10,10,10,12">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="20"/>
        </Grid.RenderTransform>

        <Border x:Name="RootBorder" Background="{DynamicResource MantleTranslucentBrush}" CornerRadius="{DynamicResource RadiusXl}"
                BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
            <Border.Effect><DynamicResource ResourceKey="ShadowSm"/></Border.Effect>

            <Grid MinHeight="70">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Color stripe -->
            <Border x:Name="Stripe" Grid.Column="0" CornerRadius="{DynamicResource RadiusXlStart}"/>

            <!-- Content -->
            <Grid Grid.Column="1" Margin="14,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title + Close -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="TitleBlock" Foreground="{DynamicResource TextBrush}"
                               FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="CloseBtn" Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="OnCloseClick"
                            Cursor="Hand" FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{DynamicResource Overlay0Brush}" Background="Transparent" BorderThickness="0"
                            Padding="4,2">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                                    CornerRadius="{DynamicResource RadiusSm}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Message -->
                <TextBlock x:Name="MessageBlock" Grid.Row="1"
                           Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeBody}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>

                <!-- Secondary -->
                <TextBlock x:Name="SecondaryBlock" Grid.Row="2"
                           Foreground="{DynamicResource Subtext0Brush}" FontSize="{StaticResource FontSizeCaption}"
                           Margin="0,2,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- Quote -->
                <TextBlock x:Name="QuoteBlock" Grid.Row="3"
                           Foreground="{DynamicResource Overlay0Brush}" FontSize="{StaticResource FontSizeCaption}"
                           FontStyle="Italic" Margin="0,6,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
