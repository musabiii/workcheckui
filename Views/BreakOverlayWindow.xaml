<Window x:Class="WorkCheck.Views.BreakOverlayWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BaseTranslucentBrush}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized">

    <Grid x:Name="OuterRoot" Opacity="0">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource MantleTranslucentBrush}" CornerRadius="16"
                BorderBrush="#22FFFFFF" BorderThickness="1"
                Padding="0" MinWidth="420" MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" Opacity="0.6" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="Stripe" Grid.Row="0" CornerRadius="16,16,0,0"/>

                <!-- Prompt mode -->
                <StackPanel x:Name="PromptPanel" Grid.Row="1" Margin="36,28,36,32">
                    <TextBlock x:Name="TitleBlock"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

<TextBlock x:Name="MessageBlock"
                               Foreground="{DynamicResource Subtext1Brush}"
                               FontSize="15"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="ChoiceCountdownBlock"
                               Foreground="{DynamicResource YellowBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"/>

                    <TextBox x:Name="DescriptionBox"
                             Foreground="{DynamicResource TextBrush}"
                             Background="{DynamicResource Surface0Brush}"
                             BorderBrush="{DynamicResource Surface1Brush}"
                             BorderThickness="1"
                             FontSize="14"
                             Padding="12,10"
                             Margin="0,20,0,0"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="500">
                        <TextBox.Text>
                            <Binding Path="SessionDescription" RelativeSource="{RelativeSource AncestorType=Window}" UpdateSourceTrigger="PropertyChanged"/>
                        </TextBox.Text>
                    </TextBox>

<StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">

                        <Button x:Name="BreakBtn" Content="☕  Сделать перерыв"
                                Click="OnBreakClick" Cursor="Hand"
                                FontSize="14" Foreground="{DynamicResource OnAccentBrush}"
                                Padding="20,10" Margin="0,0,12,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder"
                                                        Background="{DynamicResource GreenBrush}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource GreenHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="ContinueBtn" Content="Продолжить работать"
                                Click="OnContinueClick" Cursor="Hand"
                                FontSize="14" Foreground="{DynamicResource Subtext1Brush}"
                                Padding="20,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder"
                                                        Background="{DynamicResource Surface1Brush}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Timer mode -->
                <StackPanel x:Name="TimerPanel" Grid.Row="1" Margin="36,28,36,32"
                            Visibility="Collapsed">
                    <TextBlock Text="☕  Перерыв"
                               Foreground="{DynamicResource GreenBrush}"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="CountdownBlock"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="56" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"
                               FontFamily="{DynamicResource TimerFont}"/>

                    <TextBlock Text="Отдыхайте, активность не учитывается"
                               Foreground="{DynamicResource Overlay0Brush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                    <!-- Time selection buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="5 мин" Click="OnSet5Min" Cursor="Hand"
                                FontSize="13" Foreground="{DynamicResource Subtext1Brush}" Padding="16,8" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="{DynamicResource Surface1Brush}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="15 мин" Click="OnSet15Min" Cursor="Hand"
                                FontSize="13" Foreground="{DynamicResource Subtext1Brush}" Padding="16,8" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="{DynamicResource Surface1Brush}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="30 мин" Click="OnSet30Min" Cursor="Hand"
                                FontSize="13" Foreground="{DynamicResource Subtext1Brush}" Padding="16,8" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="{DynamicResource Surface1Brush}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="1 час" Click="OnSet1Hour" Cursor="Hand"
                                FontSize="13" Foreground="{DynamicResource Subtext1Brush}" Padding="16,8">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="{DynamicResource Surface1Brush}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Time addition buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Content="+5 мин" Click="OnAdd5Min" Cursor="Hand"
                                FontSize="13" Foreground="{DynamicResource Subtext1Brush}" Padding="16,8" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="{DynamicResource Surface1Brush}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="+10 мин" Click="OnAdd10Min" Cursor="Hand"
                                FontSize="13" Foreground="{DynamicResource Subtext1Brush}" Padding="16,8" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="{DynamicResource Surface1Brush}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="+30 мин" Click="OnAdd30Min" Cursor="Hand"
                                FontSize="13" Foreground="{DynamicResource Subtext1Brush}" Padding="16,8">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="{DynamicResource Surface1Brush}" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Break activity suggestions -->
                    <Border Background="#11FFFFFF" CornerRadius="8"
                            Margin="0,20,0,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="Чем заняться:" Foreground="{DynamicResource Subtext0Brush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="•  Разомни шею" Foreground="{DynamicResource Overlay0Brush}" FontSize="12.5" Margin="0,2"/>
                            <TextBlock Text="•  10 приседаний" Foreground="{DynamicResource Overlay0Brush}" FontSize="12.5" Margin="0,2"/>
                            <TextBlock Text="•  Разминка для глаз" Foreground="{DynamicResource Overlay0Brush}" FontSize="12.5" Margin="0,2"/>
                            <TextBlock Text="•  Выпей воды" Foreground="{DynamicResource Overlay0Brush}" FontSize="12.5" Margin="0,2"/>
                            <TextBlock Text="•  Убери стол" Foreground="{DynamicResource Overlay0Brush}" FontSize="12.5" Margin="0,2"/>
                            <TextBlock Text="•  Приоритеты на следующий час" Foreground="{DynamicResource Overlay0Brush}" FontSize="12.5" Margin="0,2"/>
                            <TextBlock Text="•  Планы на вечер" Foreground="{DynamicResource Overlay0Brush}" FontSize="12.5" Margin="0,2"/>
                            <TextBlock Text="•  Посчитай траты" Foreground="{DynamicResource Overlay0Brush}" FontSize="12.5" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button x:Name="PlayPauseBtn" Content="⏯  Пауза/Воспроизведение"
                                Click="OnPlayPauseClick" Cursor="Hand"
                                FontSize="14" Foreground="{DynamicResource Subtext1Brush}"
                                Padding="20,10" Margin="0,0,12,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder"
                                                        Background="{DynamicResource Surface1Brush}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="CancelBreakBtn" Content="Прервать"
                                Click="OnCancelBreakClick" Cursor="Hand"
                                FontSize="14" Foreground="{DynamicResource Subtext1Brush}"
                                Padding="24,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder"
                                                        Background="{DynamicResource Surface1Brush}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Mode Selection mode -->
                <StackPanel x:Name="ModeSelectionPanel" Grid.Row="1" Margin="36,28,36,32"
                            Visibility="Collapsed">
                    <TextBlock Text="Не у компьютера!"
                               Foreground="{DynamicResource GreenBrush}"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="LateTimerBlock"
                               Foreground="{DynamicResource RedBrush}"
                               FontSize="42" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"
                               FontFamily="{DynamicResource TimerFont}"/>

                    <Grid x:Name="TotalsGrid" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Всего вне компьютера:" Foreground="{DynamicResource Subtext1Brush}" FontSize="16"
                                   HorizontalAlignment="Right" Margin="0,2,6,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalAwayValue" Foreground="{DynamicResource RedBrush}" FontSize="16"
                                   FontWeight="Bold" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Сегодня:" Foreground="{DynamicResource Subtext1Brush}" FontSize="16"
                                   HorizontalAlignment="Right" Margin="0,2,6,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TodayValue" Foreground="{DynamicResource GreenBrush}" FontSize="16"
                                   FontWeight="Bold" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Общее время:" Foreground="{DynamicResource Subtext1Brush}" FontSize="16"
                                   HorizontalAlignment="Right" Margin="0,2,6,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GrandTotalValue" Foreground="{DynamicResource BlueBrush}" FontSize="16"
                                   FontWeight="Bold" HorizontalAlignment="Left" Margin="0,2,0,2"/>
                    </Grid>

                    <TextBlock Text="Выберите режим работы:"
                               Foreground="{DynamicResource Subtext1Brush}"
                               FontSize="16"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,28,0,0">

                        <Button x:Name="DriftBtn" Content="💤  Дрейфовать"
                                Click="OnDriftClick" Cursor="Hand"
                                FontSize="14" Foreground="{DynamicResource OnAccentBrush}"
                                Padding="20,10" Margin="0,0,12,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder"
                                                        Background="{DynamicResource Overlay0Brush}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Overlay1Brush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="WorkBtn" Content="▶  В работе"
                                Click="OnWorkClick" Cursor="Hand"
                                FontSize="14" Foreground="{DynamicResource OnAccentBrush}"
                                Padding="20,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder"
                                                        Background="{DynamicResource GreenBrush}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource GreenHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
