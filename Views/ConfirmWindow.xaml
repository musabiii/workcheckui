<Window x:Class="WorkCheck.Views.ConfirmWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="368" SizeToContent="Height">

    <Window.Resources>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource RedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RedHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RedPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BaseBrush}" CornerRadius="{DynamicResource RadiusXl}" Margin="{StaticResource WindowShadowSpace}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Border.Effect><DynamicResource ResourceKey="ShadowMd"/></Border.Effect>

        <StackPanel Margin="20,16,20,16">
            <TextBlock x:Name="TitleBlock" Foreground="{DynamicResource TextBrush}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="MessageBlock" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}"
                       TextWrapping="Wrap" LineHeight="18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}"
                        Click="OnConfirmClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
