<views:ThemedWindow x:Class="WorkCheck.Views.CompactStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkCheck.Views"
        Title="WorkCheck"
        Topmost="True"
        Width="220" Height="36"
        Surface="{Binding WindowBgBrush}"
        Shadow="{DynamicResource ShadowSm}"
        Padding="12,0,4,0"
        UsesSystemBackdrop="False">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding CurrentSessionText}"
                   Foreground="{Binding CompactSessionBrush}" FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

        <Button Grid.Column="1" Content="⛶" Click="OnExpandClick"
                Style="{StaticResource HeaderButton}" ToolTip="Развернуть"/>
    </Grid>
</views:ThemedWindow>
