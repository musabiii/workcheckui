<UserControl x:Class="WorkCheck.Views.ProjectsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtext0Brush}"/>
        </Style>

        <Style x:Key="ProjectRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
            <Setter Property="Padding" Value="10,2,2,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface0Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Add New Project -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewProjectName" Style="{StaticResource DarkTextBox}"
                     KeyDown="OnNewProjectKeyDown" ToolTip="Название нового проекта"/>
            <Button Grid.Column="1" Content="Добавить" Style="{StaticResource PrimaryButton}"
                    Click="OnAddClick" Margin="8,0,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>
                <!-- Active projects -->
                <ItemsControl x:Name="ActiveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ProjectRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="В архив" Click="OnArchiveClick"
                                            Style="{StaticResource RowAction}"
                                            ToolTip="Скрыть из выбора; статистика проекта сохранится"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Archived projects -->
                <StackPanel x:Name="ArchiveSection" Margin="0,14,0,0">
                    <TextBlock Text="Архив" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}"
                               Margin="0,0,0,4"/>
                    <ItemsControl x:Name="ArchivedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProjectRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource Overlay1Brush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="Восстановить" Click="OnRestoreClick"
                                                Style="{StaticResource RowAction}"/>
                                        <Button Grid.Column="2" Content="Удалить" Click="OnDeleteClick"
                                                Style="{StaticResource RowAction}"
                                                Foreground="{DynamicResource RedBrush}"
                                                ToolTip="Удалить окончательно"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
