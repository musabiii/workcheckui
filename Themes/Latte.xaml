<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Catppuccin Latte (light) -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#EFF1F5"/>

    <!-- Card background in dialogs with a system backdrop; this theme has none, so it is the window background -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#EFF1F5"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#EEEFF1F5"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#E6E9EF"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#F2E6E9EF"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#DCE0E8"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#DADADD"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#CCD0DA"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#BCC0CC"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#ACB0BE"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#C4C8D3"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#8C8FA1"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#7C7F93"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#6C6F85"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#5C5F77"/>
    <SolidColorBrush x:Key="TextBrush" Color="#4C4F69"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#EFF1F5"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#40A02B"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#379127"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#DF8E1D"/>
    <SolidColorBrush x:Key="RedBrush" Color="#D20F39"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#B80D32"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#A00B2C"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#33D20F39"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#1E66F5"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#1A58D6"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#164BB8"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#8839EF"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#FE640B"/>
    <SolidColorBrush x:Key="TealBrush" Color="#179299"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8839EF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7A2EDB"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6B26C2"/>

    <!-- Outline of every window -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#558839EF"/>

    <!-- Dark overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#0B000000"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#0A000000"/>

    <!-- Shape: default corners, a light shadow -->
    <DropShadowEffect x:Key="ShadowSm" Color="Black" BlurRadius="16" Opacity="0.15" ShadowDepth="2"/>
    <DropShadowEffect x:Key="ShadowMd" Color="Black" BlurRadius="20" Opacity="0.18" ShadowDepth="3"/>
    <DropShadowEffect x:Key="ShadowLg" Color="Black" BlurRadius="30" Opacity="0.22" ShadowDepth="4"/>
</ResourceDictionary>
