<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Gruvbox Dark (medium contrast, bright accents) -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#282828"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#DD282828"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#1D2021"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#E61D2021"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#32302F"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#3C3836"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#3C3836"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#504945"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#665C54"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#45403D"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#7C6F64"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#928374"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#A89984"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#BDAE93"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EBDBB2"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#282828"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#B8BB26"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#C9CC4A"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#FABD2F"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FB4934"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#FC6A59"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#CC241D"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#44FB4934"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#83A598"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#9BB7AD"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#689085"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#D3869B"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#FE8019"/>
    <SolidColorBrush x:Key="TealBrush" Color="#8EC07C"/>
</ResourceDictionary>
