<Window x:Class="WorkCheck.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkCheck"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Width="340" Height="180">

    <Border Background="{Binding WindowBgBrush}" CornerRadius="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="2"/>
        </Border.Effect>

        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="WorkCheck" Foreground="#6C7086"
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="☰" Click="OnMenuClick"
                            Style="{StaticResource HeaderButton}" Margin="0,0,4,0"
                            ToolTip="Меню">
                        <Button.ContextMenu>
                            <ContextMenu Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#33FFFFFF">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="4">
                                            <StackPanel IsItemsHost="True"/>
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="ItemBorder" Background="Transparent"
                                                            Padding="12,6" CornerRadius="4">
                                                        <ContentPresenter ContentSource="Header"
                                                                          TextElement.Foreground="#CDD6F4"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#33FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="⚙  Настройки" Command="{Binding OpenSettingsCommand}"/>
                                <MenuItem Header="📊  Статистика" Command="{Binding OpenStatisticsCommand}"/>
                                <MenuItem Header="↺  Обнулить" Command="{Binding ResetCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="📁" Command="{Binding OpenProjectsCommand}"
                            Style="{StaticResource HeaderButton}" Margin="0,0,4,0"
                            ToolTip="Проекты"/>
                    <Button Content="☕" Command="{Binding ManualBreakCommand}"
                            Style="{StaticResource HeaderButton}" Margin="0,0,4,0"
                            ToolTip="Ручной перерыв"/>
                    <Button Content="🖃" Click="OnMinimizeClick"
                            Style="{StaticResource HeaderButton}" Margin="0,0,4,0"
                            ToolTip="Свернуть"/>
                    <Button Content="✕" Command="{Binding CloseAppCommand}"
                            Style="{StaticResource CloseButton}"/>
                </StackPanel>
            </Grid>

            <!-- Stats -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Название проекта -->
                <TextBlock Text="{Binding ProjectName}" Foreground="#F9E2AF" FontSize="12"
                           FontWeight="SemiBold" HorizontalAlignment="Center"
                           Margin="0"
                           Visibility="{Binding IsWorkMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Текущая сессия -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="{Binding SessionBrush}" FontSize="13"
                               FontWeight="Bold">
                        <Run Text="{Binding SessionIcon, Mode=OneWay}"/><Run Text="{Binding SessionLabel, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentSessionText}" Foreground="{Binding SessionBrush}"
                               FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>

                <Separator Grid.Row="1" Margin="0,0,0,2" Background="#33FFFFFF" Height="1"/>

                <!-- Сегодня -->
                <Grid Margin="0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📊  Сегодня:" Foreground="#BAC2DE" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding TodayWorkedText}" Foreground="#CDD6F4"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Вне компьютера -->
                <Grid Margin="0,0" Visibility="{Binding IsWorkMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding AwayLabel}" Foreground="#BAC2DE" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding AwayTimeText}" Foreground="#CDD6F4"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>

            </StackPanel>

            <!-- Footer: mode toggle + status -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Button Content="{Binding ModeButtonText}"
                        Command="{Binding ToggleModeCommand}"
                        HorizontalAlignment="Left"
                        Style="{StaticResource HeaderButton}"
                        FontSize="12"/>

                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                           FontSize="12" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>