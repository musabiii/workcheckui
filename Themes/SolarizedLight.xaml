<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Solarized Light -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#FDF6E3"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#EEFDF6E3"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#EEE8D5"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#F2EEE8D5"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#E4DDC8"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#DEDCD6"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#E2DBC5"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#D3CBB3"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#BFB8A2"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#DAD3BC"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#93A1A1"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#839496"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#657B83"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#586E75"/>
    <SolidColorBrush x:Key="TextBrush" Color="#073642"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FDF6E3"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#859900"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#738500"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#B58900"/>
    <SolidColorBrush x:Key="RedBrush" Color="#DC322F"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#C42926"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#A8221F"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#33DC322F"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#268BD2"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#1F79B9"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#1A68A0"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#6C71C4"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#CB4B16"/>
    <SolidColorBrush x:Key="TealBrush" Color="#2AA198"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#CB4B16"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#B54213"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#9E3A10"/>

    <!-- Outline of every window -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#D3CBB3"/>

    <!-- Dark overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#0B000000"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#0A000000"/>

    <!-- Shape: slightly tighter corners, a warm light shadow -->
    <CornerRadius x:Key="RadiusMd">4</CornerRadius>
    <CornerRadius x:Key="RadiusLg">6</CornerRadius>
    <CornerRadius x:Key="RadiusXl">8</CornerRadius>
    <CornerRadius x:Key="Radius2xl">10</CornerRadius>
    <CornerRadius x:Key="RadiusXlStart">8,0,0,8</CornerRadius>
    <CornerRadius x:Key="Radius2xlTop">10,10,0,0</CornerRadius>
    <DropShadowEffect x:Key="ShadowSm" Color="#586E75" BlurRadius="16" Opacity="0.18" ShadowDepth="2"/>
    <DropShadowEffect x:Key="ShadowMd" Color="#586E75" BlurRadius="20" Opacity="0.22" ShadowDepth="3"/>
    <DropShadowEffect x:Key="ShadowLg" Color="#586E75" BlurRadius="30" Opacity="0.26" ShadowDepth="4"/>
</ResourceDictionary>
