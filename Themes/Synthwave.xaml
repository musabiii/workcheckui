<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Synthwave '84: purple night, neon pink and cyan, a pink glow around every window -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#262335"/>

    <!-- Card background in dialogs with a system backdrop; this theme has none, so it is the window background -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#262335"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#DD262335"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#241B2F"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#E6241B2F"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#1A1426"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#2E2C33"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#34294F"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#463465"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#5A4580"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#3D2F5A"/>
    <!-- Outline of text fields and check boxes -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#463465"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#848BBD"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#9A9FCB"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#C4C2DE"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#DDD9EE"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4EEFF"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#262335"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#72F1B8"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#95F5C9"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#FEDE5D"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FE4450"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#FE6872"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#E53340"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#44FE4450"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#36F9F6"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#6AFBF9"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#1EE0DD"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#C792EA"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#FF8B39"/>
    <SolidColorBrush x:Key="TealBrush" Color="#03EDF9"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7EDB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF9BE3"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#F25FCC"/>
    <!-- Accent used as a text color, e.g. the selected segment -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF7EDB"/>

    <!-- Outline of every window: a neon tube -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#CCFF7EDB"/>

    <!-- Title text of a window title bar -->
    <SolidColorBrush x:Key="WindowHeaderTextBrush" Color="#F4EEFF"/>

    <!-- Light overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#33FF7EDB"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#2236F9F6"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#11FFFFFF"/>

    <!-- Shape: soft corners and a strong pink neon glow instead of a shadow -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusXl">14</CornerRadius>
    <CornerRadius x:Key="Radius2xl">18</CornerRadius>
    <CornerRadius x:Key="RadiusXlStart">14,0,0,14</CornerRadius>
    <CornerRadius x:Key="Radius2xlTop">18,18,0,0</CornerRadius>
    <DropShadowEffect x:Key="ShadowSm" Color="#FF7EDB" BlurRadius="22" Opacity="0.5" ShadowDepth="0"/>
    <DropShadowEffect x:Key="ShadowMd" Color="#FF7EDB" BlurRadius="26" Opacity="0.55" ShadowDepth="0"/>
    <DropShadowEffect x:Key="ShadowLg" Color="#FF7EDB" BlurRadius="36" Opacity="0.6" ShadowDepth="0"/>
</ResourceDictionary>
