<Window x:Class="WorkCheck.Views.SettingsWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkCheck.Views"
        Title="Настройки — WorkCheck"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="432" Height="552"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Border Background="{DynamicResource BaseBrush}" CornerRadius="{DynamicResource RadiusXl}" Margin="{StaticResource WindowShadowSpace}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Border.Effect><DynamicResource ResourceKey="ShadowMd"/></Border.Effect>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Настройки" Foreground="{DynamicResource TextBrush}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold"/>
                <Button Content="✕" HorizontalAlignment="Right"
                        Style="{StaticResource CloseButton}"
                        Click="OnCancelClick"/>
            </Grid>

            <!-- Tabs -->
            <Border Grid.Row="1" Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="3"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="AppearanceTab" Grid.Column="0" Content="Оформление" GroupName="Tab"
                                 Style="{StaticResource SegmentRadio}" Padding="0,6"/>
                    <RadioButton x:Name="TimersTab" Grid.Column="1" Content="Таймеры" GroupName="Tab"
                                 Style="{StaticResource SegmentRadio}" Padding="0,6"/>
                    <RadioButton x:Name="NotificationsTab" Grid.Column="2" Content="Уведомления" GroupName="Tab"
                                 Style="{StaticResource SegmentRadio}" Padding="0,6"/>
                    <RadioButton x:Name="ProjectsTab" Grid.Column="3" Content="Проекты" GroupName="Tab"
                                 Style="{StaticResource SegmentRadio}" Padding="0,6"/>
                </Grid>
            </Border>

            <!-- Tab pages -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0"
                              Visibility="{Binding IsChecked, ElementName=AppearanceTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Шрифт" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Из темы" GroupName="Font"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             IsChecked="{Binding IsThemeFont}"/>
                                <RadioButton Grid.Column="1" Content="Системный" GroupName="Font"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             FontFamily="Segoe UI"
                                             IsChecked="{Binding IsSystemFont}"/>
                                <RadioButton Grid.Column="2" Content="JetBrains Mono" GroupName="Font"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             FontFamily="pack://application:,,,/files/fonts/#JetBrains Mono"
                                             IsChecked="{Binding IsJetBrainsMonoFont}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Тема" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,10,0,4"/>
                        <Border Background="{DynamicResource Surface0Brush}" CornerRadius="{DynamicResource RadiusMd}" Padding="3">
                            <UniformGrid Columns="4">
                                <RadioButton Content="Catppuccin" GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             IsChecked="{Binding IsMochaTheme}"/>
                                <RadioButton Content="GitHub" GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             IsChecked="{Binding IsGitHubDarkTheme}"/>
                                <RadioButton Content="Darcula" GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             IsChecked="{Binding IsDarculaTheme}"/>
                                <RadioButton Content="Gruvbox" GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             IsChecked="{Binding IsGruvboxTheme}"/>
                                <RadioButton Content="Tokyo Night" GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             IsChecked="{Binding IsTokyoNightTheme}"/>
                                <RadioButton Content="Dracula" GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             IsChecked="{Binding IsDraculaTheme}"/>
                                <RadioButton Content="Nord" GroupName="Theme"
                                             Style="{StaticResource SegmentRadio}" Padding="0,6"
                                             IsChecked="{Binding IsNordTheme}"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0"
                              Visibility="{Binding IsChecked, ElementName=TimersTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Pomodoro (мин)" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding PomodoroMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>

                        <TextBlock Text="Pomodoro 2 (мин)" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding Pomodoro2Minutes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>

                        <TextBlock Text="Короткий перерыв (мин)" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding ShortBreakMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>

                        <TextBlock Text="Неактивность (мин)" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding InactivityMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0"
                              Visibility="{Binding IsChecked, ElementName=NotificationsTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Telegram" Foreground="{DynamicResource TextBrush}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Bot Token" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TokenBox" Style="{StaticResource DarkPasswordBox}"/>

                        <TextBlock Text="Chat ID" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"/>

                        <TextBlock Text="SOCKS5 Прокси (user:pass@host:port)" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" ToolTip="Пример: botuser:BotPass2024@213.193.199.106:1080"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding TestStatus}"
                                       Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeCaption}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="Тест"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="OnTestTelegramClick"/>
                        </Grid>

                        <CheckBox Content="Отправлять в Telegram"
                                  IsChecked="{Binding TelegramEnabled}"
                                  Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,12,0,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <TextBlock Text="ntfy" Foreground="{DynamicResource TextBrush}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Margin="0,22,0,8"/>
                        <TextBlock Text="Сервер" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NtfyServer, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" ToolTip="Пусто — https://ntfy.sh. Свой сервер: https://ntfy.example.com"/>

                        <TextBlock Text="Подписка (топик)" Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding NtfyTopic, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"
                                 ToolTip="Имя топика, на который подписано приложение ntfy на телефоне. На ntfy.sh лучше выбрать трудноугадываемое"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding NtfyTestStatus}"
                                       Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeCaption}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="Тест"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestNtfyCommand}"/>
                        </Grid>

                        <CheckBox Content="Отправлять в ntfy"
                                  IsChecked="{Binding NtfyEnabled}"
                                  Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,12,0,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <TextBlock Text="Звук" Foreground="{DynamicResource TextBrush}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Margin="0,22,0,0"/>
                        <CheckBox Content="Звуковое уведомление о конце перерыва"
                                  IsChecked="{Binding SoundEnabled}"
                                  Foreground="{DynamicResource Subtext1Brush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,12,0,0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
                <views:ProjectsPanel x:Name="Projects"
                                     Visibility="{Binding IsChecked, ElementName=ProjectsTab, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick" Margin="0,0,8,0"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
