<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- JetBrains Darcula (IntelliJ UI and editor colors) -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#3C3F41"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#DD3C3F41"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#E62B2B2B"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#313335"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#45494A"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#45494A"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#4E5254"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#5E6366"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#4A4D4F"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#808080"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#9DA0A8"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#A9B7C6"/>
    <SolidColorBrush x:Key="TextBrush" Color="#D1D3D6"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#2B2B2B"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#6AAB73"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#7FBF88"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#FFC66D"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF6B68"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#FF8A87"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#E05553"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#44FF6B68"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#589DF6"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#7AB1F8"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#3D85E8"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#9876AA"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#CC7832"/>
    <SolidColorBrush x:Key="TealBrush" Color="#299999"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#CC7832"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D98F4F"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B5672A"/>

    <!-- Outline of every window -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#555555"/>

    <!-- Shape: tight corners and a short shadow, like the IDE -->
    <CornerRadius x:Key="RadiusXs">1</CornerRadius>
    <CornerRadius x:Key="RadiusSm">2</CornerRadius>
    <CornerRadius x:Key="RadiusMd">3</CornerRadius>
    <CornerRadius x:Key="RadiusLg">4</CornerRadius>
    <CornerRadius x:Key="RadiusXl">6</CornerRadius>
    <CornerRadius x:Key="Radius2xl">8</CornerRadius>
    <CornerRadius x:Key="RadiusXlStart">6,0,0,6</CornerRadius>
    <CornerRadius x:Key="Radius2xlTop">8,8,0,0</CornerRadius>
    <DropShadowEffect x:Key="ShadowSm" Color="Black" BlurRadius="8" Opacity="0.5" ShadowDepth="2"/>
    <DropShadowEffect x:Key="ShadowMd" Color="Black" BlurRadius="10" Opacity="0.55" ShadowDepth="2"/>
    <DropShadowEffect x:Key="ShadowLg" Color="Black" BlurRadius="16" Opacity="0.6" ShadowDepth="3"/>

    <!-- Light overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#11FFFFFF"/>
</ResourceDictionary>
