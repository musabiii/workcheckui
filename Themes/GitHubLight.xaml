<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- GitHub Light Default -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#FFFFFF"/>

    <!-- Card background in dialogs with a system backdrop; this theme has none, so it is the window background -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#FFFFFF"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#EEFFFFFF"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#F6F8FA"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#F2F6F8FA"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#EEF1F4"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#E4E4E4"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#EAEEF2"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#D0D7DE"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#AFB8C1"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#DDE3E9"/>
    <!-- Outline of text fields and check boxes -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D0D7DE"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#8C959F"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#6E7781"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#57606A"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#424A53"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#1A7F37"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#116329"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#9A6700"/>
    <SolidColorBrush x:Key="RedBrush" Color="#CF222E"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#A40E26"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#82071E"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#33CF222E"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#0969DA"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#0550AE"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#033D8B"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#8250DF"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#BC4C00"/>
    <SolidColorBrush x:Key="TealBrush" Color="#1B7C83"/>

    <!-- Signature color of the theme: GitHub's green primary button -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1F883D"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A7F37"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#116329"/>
    <!-- Accent used as a text color, e.g. the selected segment -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1F883D"/>

    <!-- Outline of every window -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#D0D7DE"/>

    <!-- Title text of a window title bar -->
    <SolidColorBrush x:Key="WindowHeaderTextBrush" Color="#1F2328"/>

    <!-- Dark overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#16000000"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#08000000"/>

    <!-- Shape: default corners, a light shadow -->
    <DropShadowEffect x:Key="ShadowSm" Color="Black" BlurRadius="16" Opacity="0.14" ShadowDepth="2"/>
    <DropShadowEffect x:Key="ShadowMd" Color="Black" BlurRadius="20" Opacity="0.17" ShadowDepth="3"/>
    <DropShadowEffect x:Key="ShadowLg" Color="Black" BlurRadius="30" Opacity="0.2" ShadowDepth="4"/>
</ResourceDictionary>
