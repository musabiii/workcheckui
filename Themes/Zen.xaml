<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Zen: almost monochrome charcoal with a muted sage accent; low contrast, nothing pulls the eye -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#1B1B1A"/>

    <!-- Card background in dialogs with a system backdrop; this theme has none, so it is the window background -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#1B1B1A"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#DD1B1B1A"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#181817"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#E6181817"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#141413"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#222221"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#262624"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#31312F"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#42423F"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#2C2C2A"/>

    <!-- Outline of text fields and check boxes -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#31312F"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#6A6964"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#7D7C76"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#9C9B94"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#B5B3AC"/>
    <SolidColorBrush x:Key="TextBrush" Color="#D6D3CB"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1B1B1A"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#8FA77A"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#A0B68C"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#C9B27C"/>
    <SolidColorBrush x:Key="RedBrush" Color="#C08A80"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#CC9A91"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#AD7A70"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#33C08A80"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#8A9FB1"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#9BAFBF"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#7A8FA1"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#A898AE"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#C4A07E"/>
    <SolidColorBrush x:Key="TealBrush" Color="#8AAFA8"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#A3B18A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#B3C09C"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#919F78"/>

    <!-- Accent used as a text color, e.g. the selected segment -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A3B18A"/>

    <!-- Outline of every window -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#14FFFFFF"/>

    <!-- Title text of a window title bar -->
    <SolidColorBrush x:Key="WindowHeaderTextBrush" Color="#D6D3CB"/>

    <!-- Overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#08FFFFFF"/>

    <!-- Shape: generous soft corners, a deep quiet shadow -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>
    <CornerRadius x:Key="Radius2xl">20</CornerRadius>
    <CornerRadius x:Key="RadiusXlStart">16,0,0,16</CornerRadius>
    <CornerRadius x:Key="Radius2xlTop">20,20,0,0</CornerRadius>
    <DropShadowEffect x:Key="ShadowSm" Color="Black" BlurRadius="30" Opacity="0.3" ShadowDepth="4"/>
    <DropShadowEffect x:Key="ShadowMd" Color="Black" BlurRadius="34" Opacity="0.35" ShadowDepth="6"/>
    <DropShadowEffect x:Key="ShadowLg" Color="Black" BlurRadius="42" Opacity="0.4" ShadowDepth="8"/>
</ResourceDictionary>
