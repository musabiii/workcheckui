<Window x:Class="WorkCheck.Views.StatisticsWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkCheck.Views"
        Title="Статистика"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Width="680" Height="440"
        MinWidth="600" MinHeight="360">

    <Window.Resources>
        <Style x:Key="StatsGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#11111A"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#313244"/>
                        <Setter Property="Foreground" Value="#A6ADC8"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#CDD6F4"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrimmedCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="SmallSegment" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadio}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.4" ShadowDepth="2"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀" Click="OnPreviousClick" Cursor="Hand"
                            Padding="10,4" FontSize="14" FontWeight="Bold"
                            Style="{StaticResource CloseButton}"/>
                    <TextBlock x:Name="DateText" Text="05.03.2026" Foreground="#A6E3A1"
                               FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="12,0"/>
                    <Button Content="▶" Click="OnNextClick" Cursor="Hand"
                            Padding="10,4" FontSize="14" FontWeight="Bold"
                            Style="{StaticResource CloseButton}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#313244" CornerRadius="6" Padding="3"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DayPeriodRadio" Content="День" GroupName="Period"
                                     Style="{StaticResource SegmentRadio}" IsChecked="True"
                                     Checked="OnFilterChanged"/>
                        <RadioButton x:Name="WeekPeriodRadio" Content="Неделя" GroupName="Period"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="OnFilterChanged"/>
                        <RadioButton x:Name="MonthPeriodRadio" Content="Месяц" GroupName="Period"
                                     Style="{StaticResource SegmentRadio}"
                                     Checked="OnFilterChanged"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="2" Content="✕" Click="OnCloseClick" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource CloseButton}"/>
            </Grid>

            <!-- Summary -->
            <Border Grid.Row="1" Background="#181825" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Всего сессий" Foreground="#6C7086" FontSize="12"/>
                            <TextBlock x:Name="SessionCountText" Text="0" Foreground="#CDD6F4"
                                       FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Общее время" Foreground="#6C7086" FontSize="12"/>
                            <TextBlock x:Name="TotalTimeText" Text="0 мин" Foreground="#A6E3A1"
                                       FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Сессии:" Foreground="#6C7086" FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#313244" CornerRadius="6" Padding="2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AllSessionsRadio" Content="Все" GroupName="SessionFilter"
                                                 Style="{StaticResource SmallSegment}" IsChecked="True"
                                                 Checked="OnFilterChanged"/>
                                    <RadioButton Content="Полные сессии" GroupName="SessionFilter"
                                                 Style="{StaticResource SmallSegment}"
                                                 Checked="OnFilterChanged"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#313244" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ListViewRadio" Content="Список" GroupName="SessionView"
                                                 Style="{StaticResource SmallSegment}"
                                                 IsChecked="True" Checked="OnViewChanged"/>
                                    <RadioButton Content="Диаграмма" GroupName="SessionView"
                                                 Style="{StaticResource SmallSegment}"
                                                 Checked="OnViewChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="GanttView" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <views:GanttChart x:Name="Gantt" VerticalAlignment="Top"/>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ListView" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <DataGrid x:Name="SessionsGrid" Style="{StaticResource StatsGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat={}{0:HH:mm}}" Width="70"/>
                                    <DataGridTextColumn Header="Конец" Binding="{Binding EndTime, StringFormat={}{0:HH:mm}}" Width="70"/>
                                    <DataGridTextColumn Header="Длительность" Binding="{Binding DurationText}" Width="110"/>
                                    <DataGridTextColumn Header="Проект" Binding="{Binding ProjectName}" Width="130"
                                                        ElementStyle="{StaticResource TrimmedCell}"/>
                                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid x:Name="PeriodGrid" Style="{StaticResource StatsGrid}" Visibility="Collapsed">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Background" Value="#313244"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer -->
            <Button Grid.Row="2" Content="Закрыть" Click="OnCloseClick"
                    HorizontalAlignment="Stretch" Padding="12,8"
                    FontSize="14" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="#45475A" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#585B70"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
