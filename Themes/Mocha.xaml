<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Catppuccin Mocha -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#1E1E2E"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#DD1E1E2E"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#181825"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#E6181825"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#11111A"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#313131"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#313244"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#45475A"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#585B70"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#3E3E52"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#6C7086"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#7C8094"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#A6ADC8"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#BAC2DE"/>
    <SolidColorBrush x:Key="TextBrush" Color="#CDD6F4"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1E1E2E"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#A6E3A1"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#B8EBB2"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#F9E2AF"/>
    <SolidColorBrush x:Key="RedBrush" Color="#F38BA8"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#F5A3B9"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#E8708F"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#44F38BA8"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#89B4FA"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#B4D0FB"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#74A8F8"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#CBA6F7"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#FAB387"/>
    <SolidColorBrush x:Key="TealBrush" Color="#94E2D5"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#CBA6F7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D9BEF9"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B88EF4"/>

    <!-- Outline of every window -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#55CBA6F7"/>

    <!-- Light overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#11FFFFFF"/>
</ResourceDictionary>
