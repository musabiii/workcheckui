<Window x:Class="WorkCheck.Views.ProjectsWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BaseTranslucentBrush}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Width="350" Height="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <TextBlock Text="Проекты" Foreground="{DynamicResource TextBrush}"
                       FontSize="18" FontWeight="Bold"/>
            <Button Content="✕" HorizontalAlignment="Right"
                   Click="OnCloseClick"
                   Background="Transparent" Foreground="{DynamicResource Overlay0Brush}"
                   BorderThickness="0" FontSize="14" Cursor="Hand"
                   Padding="4,0"/>
        </Grid>

        <!-- Projects List -->
        <ListBox x:Name="ProjectsList" Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{DynamicResource TextBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕"
                                Click="OnDeleteClick"
                                Background="Transparent" Foreground="{DynamicResource RedBrush}"
                                BorderThickness="0" FontSize="12" Cursor="Hand"
                                Padding="8,4"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Add New Project -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBox x:Name="NewProjectName" 
                    Foreground="{DynamicResource TextBrush}" Background="{DynamicResource Surface0Brush}"
                    BorderBrush="{DynamicResource Surface1Brush}" BorderThickness="1"
                    FontSize="14" Padding="8,6"
                    Margin="0,0,0,8"
                    ToolTip="Название проекта"/>
            <Button Content="Добавить" Click="OnAddClick"
                    Background="{DynamicResource GreenBrush}" Foreground="{DynamicResource OnAccentBrush}"
                    Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>