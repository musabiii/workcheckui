<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 95: gray 3D bevels, a navy title bar, the teal desktop, Microsoft Sans Serif -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#C0C0C0"/>

    <!-- Card background in dialogs with a system backdrop; this theme has none, so it is the window background -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#C0C0C0"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#EEC0C0C0"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#F2C0C0C0"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#B4B4B4"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#A8A8A8"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#808080"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#DFDFDF"/>

    <!-- Outline of text fields and check boxes -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#808080"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#808080"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#606060"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#404040"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#202020"/>
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#008000"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#006400"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#808000"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF0000"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#CC0000"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#990000"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#33FF0000"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#0000FF"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#0000CC"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#000099"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#800080"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#FF8000"/>
    <SolidColorBrush x:Key="TealBrush" Color="#008080"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#000080"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0000A0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#000060"/>

    <!-- Accent used as a text color, e.g. the selected segment -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000080"/>

    <!-- Outline of every window -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#000000"/>

    <!-- Title text of a window title bar -->
    <SolidColorBrush x:Key="WindowHeaderTextBrush" Color="#FFFFFF"/>

    <!-- Overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#33000080"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#1A000080"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#808080"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#10000000"/>

    <!-- Shape: square everything, no soft shadows; bevels on buttons, fields and windows; a navy title bar -->
    <CornerRadius x:Key="RadiusXs">0</CornerRadius>
    <CornerRadius x:Key="RadiusSm">0</CornerRadius>
    <CornerRadius x:Key="RadiusMd">0</CornerRadius>
    <CornerRadius x:Key="RadiusLg">0</CornerRadius>
    <CornerRadius x:Key="RadiusXl">0</CornerRadius>
    <CornerRadius x:Key="Radius2xl">0</CornerRadius>
    <CornerRadius x:Key="RadiusXlStart">0,0,0,0</CornerRadius>
    <CornerRadius x:Key="Radius2xlTop">0,0,0,0</CornerRadius>
    <DropShadowEffect x:Key="ShadowSm" Color="Black" BlurRadius="0" Opacity="0" ShadowDepth="0"/>
    <DropShadowEffect x:Key="ShadowMd" Color="Black" BlurRadius="0" Opacity="0" ShadowDepth="0"/>
    <DropShadowEffect x:Key="ShadowLg" Color="Black" BlurRadius="0" Opacity="0" ShadowDepth="0"/>
    <Thickness x:Key="BevelTopLeft">1,1,0,0</Thickness>
    <Thickness x:Key="BevelBottomRight">0,0,1,1</Thickness>
    <SolidColorBrush x:Key="BevelLightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BevelDarkBrush" Color="#404040"/>
    <SolidColorBrush x:Key="WindowHeaderBrush" Color="#000080"/>
    <Thickness x:Key="WindowHeaderPadding">8,4,4,4</Thickness>
</ResourceDictionary>
