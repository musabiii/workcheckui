<Window x:Class="WorkCheck.Views.AboutWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О приложении — WorkCheck"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="440" Height="340"
        ShowInTaskbar="False">

    <Border Background="#1E1E2E" CornerRadius="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" ShadowDepth="3"/>
        </Border.Effect>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="О приложении" Foreground="#CDD6F4" FontSize="16" FontWeight="Bold"/>
                <Button Content="✕" HorizontalAlignment="Right"
                        Style="{StaticResource CloseButton}"
                        Click="OnCloseClick"/>
            </Grid>

            <!-- Info -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="WorkCheck" Foreground="#F9E2AF" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionBlock" Foreground="#6C7086" FontSize="12" Margin="0,2,0,16"/>

                <TextBlock Text="Программа" Foreground="#BAC2DE" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="AppPathBox" IsReadOnly="True"
                         Foreground="#CDD6F4" Background="#313244"
                         BorderBrush="#45475A" BorderThickness="1"
                         FontSize="12" Padding="8,6"
                         TextWrapping="Wrap" Margin="0,0,0,16"/>

                <TextBlock Text="База данных" Foreground="#BAC2DE" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="DbPathBox" IsReadOnly="True"
                         Foreground="#CDD6F4" Background="#313244"
                         BorderBrush="#45475A" BorderThickness="1"
                         FontSize="12" Padding="8,6"
                         TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Content="Копировать пути" Click="OnCopyClick"
                        HorizontalAlignment="Left"
                        Style="{StaticResource HeaderButton}"
                        FontSize="12"/>
            </Grid>
        </Grid>
    </Border>
</Window>
