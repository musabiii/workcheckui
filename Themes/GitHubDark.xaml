<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- GitHub Dark Default -->

    <!-- Window background -->
    <SolidColorBrush x:Key="BaseBrush" Color="#0D1117"/>

    <!-- Card background in dialogs with a system backdrop; this theme has none, so it is the window background -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#0D1117"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#DD0D1117"/>

    <!-- Inset panels -->
    <SolidColorBrush x:Key="MantleBrush" Color="#010409"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#E6010409"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#0D1117"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#161B22"/>

    <!-- Inputs, toggles, buttons -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#21262D"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#30363D"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#484F58"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#262C36"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#6E7681"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#7D8590"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#8B949E"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#B1BAC4"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6EDF3"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0D1117"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="GreenBrush" Color="#3FB950"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#56D364"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#D29922"/>
    <SolidColorBrush x:Key="RedBrush" Color="#F85149"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#FF7B72"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#DA3633"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#44F85149"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#58A6FF"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#79C0FF"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#388BFD"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#BC8CFF"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#F0883E"/>
    <SolidColorBrush x:Key="TealBrush" Color="#39C5CF"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#79C0FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#388BFD"/>

    <!-- Outline of every window -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#30363D"/>

    <!-- Light overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#11FFFFFF"/>
</ResourceDictionary>
