<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Liquid Glass, after Apple's light appearance: frosted translucent surfaces, a bright edge,
         large corners, system blue. Dialogs get a real blurred backdrop (see WindowBackdrop) -->

    <!-- Window background; windows without the system blur need it nearly opaque to stay readable -->
    <SolidColorBrush x:Key="BaseBrush" Color="#EDF5F5F8"/>

    <!-- Tint over the system blur in dialogs that have it; themes without a backdrop set it to their BaseBrush -->
    <SolidColorBrush x:Key="BackdropTintBrush" Color="#8CF7F7FA"/>

    <!-- Semi-transparent window background -->
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="#B8F2F2F7"/>

    <!-- Inset panels: a lighter sheet of glass -->
    <SolidColorBrush x:Key="MantleBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="MantleTranslucentBrush" Color="#D9FFFFFF"/>

    <!-- Alternating rows and stripes -->
    <SolidColorBrush x:Key="CrustBrush" Color="#0D000000"/>

    <!-- Status window background while drifting -->
    <SolidColorBrush x:Key="DriftBaseBrush" Color="#EDE5E5EA"/>

    <!-- Inputs, toggles, buttons: system gray fills; the selected segment is a white pill -->
    <SolidColorBrush x:Key="Surface0Brush" Color="#1F767680"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#4D767680"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#2E767680"/>
    <!-- Outline of text fields and check boxes -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFFFFFFF"/>

    <!-- Muted text and icons -->
    <SolidColorBrush x:Key="Overlay0Brush" Color="#8E8E93"/>
    <SolidColorBrush x:Key="Overlay1Brush" Color="#7C7C82"/>
    <SolidColorBrush x:Key="Subtext0Brush" Color="#5E5E64"/>
    <SolidColorBrush x:Key="Subtext1Brush" Color="#48484D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F"/>

    <!-- Text on accent-colored buttons and bars -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <!-- Accents (Apple system colors) -->
    <SolidColorBrush x:Key="GreenBrush" Color="#28A745"/>
    <SolidColorBrush x:Key="GreenHoverBrush" Color="#23943D"/>
    <SolidColorBrush x:Key="YellowBrush" Color="#F08A00"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF3B30"/>
    <SolidColorBrush x:Key="RedHoverBrush" Color="#E6352B"/>
    <SolidColorBrush x:Key="RedPressedBrush" Color="#CC2F26"/>
    <SolidColorBrush x:Key="RedTranslucentBrush" Color="#33FF3B30"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#007AFF"/>
    <SolidColorBrush x:Key="BlueHoverBrush" Color="#0A6FE0"/>
    <SolidColorBrush x:Key="BluePressedBrush" Color="#0062CC"/>
    <SolidColorBrush x:Key="MauveBrush" Color="#AF52DE"/>
    <SolidColorBrush x:Key="PeachBrush" Color="#FF9500"/>
    <SolidColorBrush x:Key="TealBrush" Color="#30B0C7"/>

    <!-- Signature color of the theme: primary button, selected segment, focus, sliders -->
    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0A6FE0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0062CC"/>
    <!-- Accent used as a text color, e.g. the selected segment -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#007AFF"/>

    <!-- Outline of every window: the bright edge of a glass sheet -->
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#B3FFFFFF"/>

    <!-- Title text of a window title bar -->
    <SolidColorBrush x:Key="WindowHeaderTextBrush" Color="#1D1D1F"/>

    <!-- Dark overlays on top of any surface: hover, separators, chart grid, faint panels -->
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="HoverSubtleBrush" Color="#0B000000"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="PanelTintBrush" Color="#33FFFFFF"/>

    <!-- Shape: large continuous corners, pill-like segments, a soft deep shadow -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">14</CornerRadius>
    <CornerRadius x:Key="RadiusXl">22</CornerRadius>
    <CornerRadius x:Key="Radius2xl">28</CornerRadius>
    <CornerRadius x:Key="RadiusXlStart">22,0,0,22</CornerRadius>
    <CornerRadius x:Key="Radius2xlTop">28,28,0,0</CornerRadius>
    <DropShadowEffect x:Key="ShadowSm" Color="Black" BlurRadius="24" Opacity="0.16" ShadowDepth="6"/>
    <DropShadowEffect x:Key="ShadowMd" Color="Black" BlurRadius="30" Opacity="0.2" ShadowDepth="8"/>
    <DropShadowEffect x:Key="ShadowLg" Color="Black" BlurRadius="40" Opacity="0.24" ShadowDepth="10"/>
</ResourceDictionary>
