<Window x:Class="WorkCheck.Views.BreakOverlayWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BaseTranslucentBrush}"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- The overlay is a full-screen focus moment, so its main buttons are a size up from the shared ones -->
        <Style x:Key="OverlayPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>
        <Style x:Key="OverlaySecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeLarge}"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>

        <Style x:Key="OverlayPanel" TargetType="StackPanel">
            <Setter Property="Grid.Row" Value="2"/>
            <Setter Property="Margin" Value="36,24,36,32"/>
        </Style>
        <Style x:Key="ButtonRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- A stat in the totals row: the value on top, its caption under it -->
        <Style x:Key="TotalValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource TimerFont}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TotalLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay0Brush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="SuggestionItem" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Overlay0Brush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="OuterRoot" Opacity="0">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="420" MaxWidth="500"
                Background="{DynamicResource MantleTranslucentBrush}" CornerRadius="{DynamicResource Radius2xl}"
                BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="{DynamicResource WindowBorderThickness}">
            <Border.Effect><DynamicResource ResourceKey="ShadowLg"/></Border.Effect>

            <!-- Raised bevel, as on every themed window (only themes with bevels give it a thickness) -->
            <Border BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelTopLeft}"
                    CornerRadius="{DynamicResource Radius2xl}">
                <Border BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelBottomRight}"
                        CornerRadius="{DynamicResource Radius2xl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="Stripe" Grid.Row="0" CornerRadius="{DynamicResource Radius2xlTop}"/>

                        <!-- The project the break belongs to (work mode only); its own row above the panels, so it stays in every mode -->
                        <Border x:Name="ProjectChip" Grid.Row="1" Margin="36,20,36,0" Visibility="Collapsed"
                                HorizontalAlignment="Center" Padding="10,3"
                                Background="{DynamicResource PanelTintBrush}" CornerRadius="{DynamicResource RadiusMd}">
                            <TextBlock x:Name="ProjectBlock"
                                       Foreground="{DynamicResource YellowBrush}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <!-- Prompt mode -->
                        <StackPanel x:Name="PromptPanel" Style="{StaticResource OverlayPanel}">
                            <TextBlock x:Name="TitleBlock"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="{StaticResource FontSizeHeadline}" FontWeight="Bold"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                            <TextBlock x:Name="MessageBlock" Margin="0,12,0,0"
                                       Foreground="{DynamicResource Subtext1Brush}"
                                       FontSize="{StaticResource FontSizeSubtitle}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                            <TextBlock x:Name="ChoiceCountdownBlock" Margin="0,8,0,0"
                                       Foreground="{DynamicResource YellowBrush}"
                                       FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBox x:Name="DescriptionBox" Style="{StaticResource TextInput}" TextChanged="OnDescriptionChanged"
                                     FontSize="{StaticResource FontSizeLarge}" Padding="12,10"
                                     Margin="0,20,0,0" Height="80" MaxLength="500"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto">
                                <TextBox.Text>
                                    <Binding Path="SessionDescription" RelativeSource="{RelativeSource AncestorType=Window}" UpdateSourceTrigger="PropertyChanged"/>
                                </TextBox.Text>
                            </TextBox>

                            <StackPanel Style="{StaticResource ButtonRow}" Margin="0,16,0,0">
                                <Button x:Name="BreakBtn" Content="☕  Сделать перерыв" Click="OnBreakClick"
                                        Style="{StaticResource OverlayPrimaryButton}" Margin="0,0,12,0"/>
                                <Button x:Name="ContinueBtn" Content="Продолжить работать" Click="OnContinueClick"
                                        Style="{StaticResource OverlaySecondaryButton}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Timer mode -->
                        <StackPanel x:Name="TimerPanel" Style="{StaticResource OverlayPanel}" Visibility="Collapsed">
                            <TextBlock Text="☕  Перерыв"
                                       Foreground="{DynamicResource GreenBrush}"
                                       FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="CountdownBlock" Margin="0,16,0,0"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontFamily="{DynamicResource TimerFont}"
                                       FontSize="{StaticResource FontSizeHero}" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Отдыхайте, активность не учитывается" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Overlay0Brush}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       HorizontalAlignment="Center"/>

                            <!-- Break length: set it, or add to it -->
                            <StackPanel Style="{StaticResource ButtonRow}" Margin="0,16,0,0">
                                <Button Content="5 мин" Click="OnSet5Min" Style="{StaticResource ChipButton}"/>
                                <Button Content="15 мин" Click="OnSet15Min" Style="{StaticResource ChipButton}"/>
                                <Button Content="30 мин" Click="OnSet30Min" Style="{StaticResource ChipButton}"/>
                                <Button Content="1 час" Click="OnSet1Hour" Style="{StaticResource ChipButton}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource ButtonRow}" Margin="0,8,0,0">
                                <Button Content="+5 мин" Click="OnAdd5Min" Style="{StaticResource ChipButton}"/>
                                <Button Content="+10 мин" Click="OnAdd10Min" Style="{StaticResource ChipButton}"/>
                                <Button Content="+30 мин" Click="OnAdd30Min" Style="{StaticResource ChipButton}"/>
                            </StackPanel>

                            <!-- Optional: describe the session that just ended (the only chance on a manual break) -->
                            <TextBlock Text="Над чем работали?" Style="{StaticResource FieldLabel}" Margin="0,20,0,4"/>
                            <TextBox x:Name="TimerDescriptionBox" Style="{StaticResource TextInput}"
                                     FontSize="{StaticResource FontSizeBody}" Padding="10,6" Height="52" MaxLength="500"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto">
                                <TextBox.Text>
                                    <Binding Path="SessionDescription" RelativeSource="{RelativeSource AncestorType=Window}" UpdateSourceTrigger="PropertyChanged"/>
                                </TextBox.Text>
                            </TextBox>

                            <!-- Break activity suggestions -->
                            <Border Background="{DynamicResource PanelTintBrush}" CornerRadius="{DynamicResource RadiusLg}"
                                    Margin="0,20,0,0" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="Чем заняться:" Margin="0,0,0,6"
                                               Foreground="{DynamicResource Subtext0Brush}"
                                               FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"/>
                                    <!-- Two columns keep the card short enough for a laptop screen at 150% -->
                                    <UniformGrid Columns="2">
                                        <TextBlock Text="•  Разомни шею" Style="{StaticResource SuggestionItem}"/>
                                        <TextBlock Text="•  Убери стол" Style="{StaticResource SuggestionItem}"/>
                                        <TextBlock Text="•  10 приседаний" Style="{StaticResource SuggestionItem}"/>
                                        <TextBlock Text="•  Приоритеты на час" Style="{StaticResource SuggestionItem}"/>
                                        <TextBlock Text="•  Разминка для глаз" Style="{StaticResource SuggestionItem}"/>
                                        <TextBlock Text="•  Планы на вечер" Style="{StaticResource SuggestionItem}"/>
                                        <TextBlock Text="•  Выпей воды" Style="{StaticResource SuggestionItem}"/>
                                        <TextBlock Text="•  Посчитай траты" Style="{StaticResource SuggestionItem}"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <StackPanel Style="{StaticResource ButtonRow}" Margin="0,24,0,0">
                                <Button x:Name="PlayPauseBtn" Content="⏯  Пауза/Воспроизведение" Click="OnPlayPauseClick"
                                        Style="{StaticResource OverlaySecondaryButton}" Margin="0,0,12,0"/>
                                <Button x:Name="CancelBreakBtn" Content="Прервать" Click="OnCancelBreakClick"
                                        Style="{StaticResource OverlaySecondaryButton}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Mode Selection mode -->
                        <StackPanel x:Name="ModeSelectionPanel" Style="{StaticResource OverlayPanel}" Visibility="Collapsed">
                            <TextBlock Text="Не у компьютера!"
                                       Foreground="{DynamicResource GreenBrush}"
                                       FontSize="{StaticResource FontSizeHeadline}" FontWeight="Bold"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>

                            <TextBlock x:Name="LateTimerBlock" Margin="0,16,0,0"
                                       Foreground="{DynamicResource RedBrush}"
                                       FontFamily="{DynamicResource TimerFont}"
                                       FontSize="{StaticResource FontSizeDisplay}" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <Border x:Name="TotalsGrid" Margin="0,16,0,0" Padding="8,10" Visibility="Collapsed"
                                    Background="{DynamicResource PanelTintBrush}" CornerRadius="{DynamicResource RadiusLg}">
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock x:Name="TodayValue" Style="{StaticResource TotalValue}" Foreground="{DynamicResource GreenBrush}"/>
                                        <TextBlock Text="работа сегодня" Style="{StaticResource TotalLabel}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="TotalAwayValue" Style="{StaticResource TotalValue}" Foreground="{DynamicResource RedBrush}"/>
                                        <TextBlock Text="вне компьютера" Style="{StaticResource TotalLabel}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="GrandTotalValue" Style="{StaticResource TotalValue}" Foreground="{DynamicResource BlueBrush}"/>
                                        <TextBlock Text="всего" Style="{StaticResource TotalLabel}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <TextBlock x:Name="QuoteBlock" Margin="0,20,0,4"
                                       Foreground="{DynamicResource Subtext0Brush}"
                                       FontSize="{StaticResource FontSizeLarge}" FontStyle="Italic"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                            <TextBlock Text="Выберите режим работы:" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Subtext1Brush}"
                                       FontSize="{StaticResource FontSizeSubtitle}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>

                            <StackPanel Style="{StaticResource ButtonRow}" Margin="0,28,0,0">
                                <Button x:Name="DriftBtn" Content="💤  Дрейфовать" Click="OnDriftClick"
                                        Style="{StaticResource OverlaySecondaryButton}" Margin="0,0,12,0"/>
                                <Button x:Name="WorkBtn" Content="▶  В работе" Click="OnWorkClick"
                                        Style="{StaticResource OverlayPrimaryButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Border>
    </Grid>
</Window>
