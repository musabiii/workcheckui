<Window x:Class="WorkCheck.Views.CompactStatusWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkCheck"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Width="252" Height="68">

    <Border Background="{Binding WindowBgBrush}" CornerRadius="{DynamicResource RadiusXl}" Margin="{StaticResource WindowShadowSpace}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Border.Effect><DynamicResource ResourceKey="ShadowSm"/></Border.Effect>

        <Grid Margin="12,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding CurrentSessionText}"
                       Foreground="{Binding CompactSessionBrush}" FontSize="{StaticResource FontSizeLarge}" FontWeight="Bold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="1" Content="⛶" Click="OnExpandClick"
                    Style="{StaticResource HeaderButton}" ToolTip="Развернуть"/>
        </Grid>
    </Border>
</Window>
