<Window x:Class="WorkCheck.Views.ConfirmWindow"
        FontFamily="{DynamicResource AppFont}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="360" SizeToContent="Height">

    <Window.Resources>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F5A3B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E8708F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="12" Margin="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" Opacity="0.5" ShadowDepth="2"/>
        </Border.Effect>

        <StackPanel Margin="20,16,20,16">
            <TextBlock x:Name="TitleBlock" Foreground="#CDD6F4" FontSize="15" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="MessageBlock" Foreground="#BAC2DE" FontSize="12"
                       TextWrapping="Wrap" LineHeight="18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}"
                        Click="OnConfirmClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
